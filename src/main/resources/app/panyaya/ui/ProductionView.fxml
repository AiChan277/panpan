<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.ProductionController" styleClass="view">
    <HBox styleClass="toolbar">
        <ComboBox fx:id="statusFilter" prefWidth="160"/>
        <Label text="Plan -> Start (ingredients are used) -> Complete (bread goes to stock)" styleClass="hint"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Plan production" styleClass="primary" onAction="#onPlan"/>
        <Button fx:id="startButton" text="Start" onAction="#onStart"/>
        <Button fx:id="completeButton" text="Complete" onAction="#onComplete"/>
        <Button fx:id="failButton" text="Mark failed" onAction="#onFail"/>
        <Button fx:id="cancelButton" text="Cancel plan" onAction="#onCancel"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <TableView fx:id="table"/>
        <VBox spacing="6">
            <Label fx:id="detailTitle" text="Select an order to see its ingredients" styleClass="card-title"/>
            <Label fx:id="detailInfo" styleClass="muted" wrapText="true"/>
            <TableView fx:id="detailTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>
</VBox>
