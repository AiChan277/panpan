<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.ProductionController" styleClass="view">
    <HBox styleClass="toolbar">
        <ComboBox fx:id="statusFilter" prefWidth="170" minWidth="120"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button fx:id="cancelButton" text="Cancel plan" onAction="#onCancel">
            <graphic><Icon name="ban" size="15"/></graphic>
        </Button>
        <Button fx:id="failButton" text="Mark failed" onAction="#onFail">
            <graphic><Icon name="x-circle" size="15"/></graphic>
        </Button>
        <Button fx:id="completeButton" text="Complete" onAction="#onComplete">
            <graphic><Icon name="check-circle" size="15"/></graphic>
        </Button>
        <Button fx:id="startButton" text="Start" onAction="#onStart">
            <graphic><Icon name="play" size="15"/></graphic>
        </Button>
        <Button text="Plan production" styleClass="primary" onAction="#onPlan" minWidth="-Infinity">
            <graphic><Icon name="plus" size="15"/></graphic>
        </Button>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" minHeight="160"/>
        <VBox spacing="8" minHeight="150">
            <HBox styleClass="section-header">
                <Icon name="ingredients" size="16"/>
                <Label fx:id="detailTitle" text="Select an order to see its ingredients" styleClass="card-title"/>
            </HBox>
            <Label fx:id="detailInfo" styleClass="detail-meta" wrapText="true"/>
            <TableView fx:id="detailTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>
</VBox>
