<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.CardGrid?>
<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.BackupController" styleClass="view">
    <CardGrid minColumnWidth="380" maxColumns="2" hgap="14" vgap="14">
        <VBox styleClass="panel">
            <HBox styleClass="panel-header">
                <Icon name="database" size="16"/>
                <Label text="Back up now" styleClass="card-title"/>
            </HBox>
            <Label text="Creates a .panyabak file (a ZIP with the data and a checksum manifest). Copy it to a USB stick or another computer regularly."
                   styleClass="hint" wrapText="true"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox>
                <Button text="Create backup..." styleClass="primary" onAction="#onBackup">
                    <graphic><Icon name="download" size="15"/></graphic>
                </Button>
            </HBox>
        </VBox>
        <VBox styleClass="panel">
            <HBox styleClass="panel-header">
                <Icon name="restore" size="16"/>
                <Label text="Restore" styleClass="card-title"/>
            </HBox>
            <Label text="The backup is fully checked first. Your current data is backed up automatically before it is replaced."
                   styleClass="hint" wrapText="true"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox>
                <Button text="Restore from file..." styleClass="danger" onAction="#onRestoreFile">
                    <graphic><Icon name="upload" size="15"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </CardGrid>
    <HBox styleClass="toolbar">
        <Label text="Automatic backups" styleClass="section-title" minWidth="-Infinity"/>
        <Label text="one per day, plus one before every restore" styleClass="hint" minWidth="0"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button text="Open backup folder" onAction="#onOpenFolder">
            <graphic><Icon name="folder" size="15"/></graphic>
        </Button>
        <Button text="Verify selected" onAction="#onVerify">
            <graphic><Icon name="shield" size="15"/></graphic>
        </Button>
        <Button text="Restore selected" styleClass="danger" onAction="#onRestoreSelected">
            <graphic><Icon name="restore" size="15"/></graphic>
        </Button>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <Label fx:id="locationLabel" styleClass="hint" wrapText="true"/>
</VBox>
