<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    ForgotPasswordView.fxml  –  Layar "Lupa Kata Sandi"
    Controller: app.panyaya.ui.ForgotPasswordController

    Langkah 1: stepVerifyPane  – Username + Pertanyaan Keamanan
    Langkah 2: stepResetPane   – Kata Sandi Baru
-->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="app.panyaya.ui.ForgotPasswordController"
           styleClass="auth-background">

    <VBox styleClass="auth-card" maxWidth="420" maxHeight="-Infinity" spacing="12">

        <!-- Header -->
        <Label text="パン屋ヤ" styleClass="brand-jp"/>
        <Label text="PAN-YA YA" styleClass="brand-latin"/>
        <Label text="Reset Kata Sandi" styleClass="tagline"/>
        <Label fx:id="bakeryLabel" styleClass="muted"/>

        <!-- ═══════════════════════════════════════════
             LANGKAH 1: Verifikasi identitas
             ═══════════════════════════════════════════ -->
        <VBox fx:id="stepVerifyPane" spacing="10">
            <Label text="Username" styleClass="form-label"/>
            <TextField fx:id="usernameField" promptText="Masukkan username Anda"
                       onAction="#onLookup"/>

            <!-- Pertanyaan keamanan (hanya tampil setelah lookup berhasil) -->
            <VBox fx:id="securityQuestionPane" managed="false" visible="false" spacing="10">
                <Label fx:id="questionLabel" styleClass="hint" wrapText="true"/>
                <Label text="Jawaban" styleClass="form-label"/>
                <TextField fx:id="answerField" promptText="Jawaban Anda"
                           onAction="#onVerify"/>
                <Button fx:id="verifyButton" text="Verifikasi →" maxWidth="Infinity"
                        defaultButton="true" onAction="#onVerify"/>
            </VBox>

            <!-- Tombol Lanjutkan (tersembunyi setelah pertanyaan muncul) -->
            <Button fx:id="lookupButton" text="Lanjutkan →" maxWidth="Infinity"
                    defaultButton="true" styleClass="primary" onAction="#onLookup"/>
        </VBox>

        <!-- ═══════════════════════════════════════════
             LANGKAH 2: Buat kata sandi baru
             ═══════════════════════════════════════════ -->
        <VBox fx:id="stepResetPane" managed="false" visible="false" spacing="10">
            <Label text="Buat Kata Sandi Baru" styleClass="tagline"/>
            <Label fx:id="resetSubtitle" styleClass="muted" wrapText="true"/>
            <Label text="Kata Sandi Baru" styleClass="form-label"/>
            <PasswordField fx:id="newPasswordField" promptText="Minimal 8 karakter"
                           onAction="#onReset"/>
            <Label text="Ulangi Kata Sandi Baru" styleClass="form-label"/>
            <PasswordField fx:id="confirmPasswordField" onAction="#onReset"/>
            <Button fx:id="resetButton" text="Simpan Kata Sandi Baru" maxWidth="Infinity"
                    defaultButton="true" styleClass="primary" onAction="#onReset"/>
        </VBox>

        <!-- Error / Info label (dipakai di kedua langkah) -->
        <Label fx:id="errorLabel" wrapText="true" maxWidth="Infinity"
               managed="false" visible="false"/>

        <!-- Tombol kembali -->
        <Button text="← Kembali ke halaman masuk" maxWidth="Infinity"
                styleClass="link-button" onAction="#onBack"/>

    </VBox>
</StackPane>
