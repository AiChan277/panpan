<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    ForgotPasswordView.fxml  –  Layar "Lupa Kata Sandi"
    Controller: app.panyaya.ui.ForgotPasswordController

    Langkah 1: stepVerifyPane  – Username + Pertanyaan Keamanan
    Langkah 2: stepResetPane   – Kata Sandi Baru
-->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="root"
      fx:controller="app.panyaya.ui.ForgotPasswordController" styleClass="auth-root">
    <VBox fx:id="brandPanel" styleClass="auth-brand">
        <HBox styleClass="auth-brand-row">
            <ImageView fitWidth="40" fitHeight="40" preserveRatio="true" smooth="true">
                <Image url="@img/icon-64.png"/>
            </ImageView>
            <VBox>
                <Label text="パン屋ヤ" styleClass="auth-brand-jp"/>
                <Label text="PAN-YA YA  ·  BAKERY OPERATIONS" styleClass="auth-brand-name"/>
            </VBox>
        </HBox>
        <Region VBox.vgrow="ALWAYS" minHeight="40"/>
        <Label text="From ingredients to sales." styleClass="auth-statement" wrapText="true"/>
        <Region minHeight="12"/>
        <Label text="Recipes, stock lots, production, the shop counter and the numbers behind them - in one place for the whole team."
               styleClass="auth-copy" wrapText="true"/>
        <Region minHeight="28"/>
        <VBox spacing="14">
            <HBox styleClass="auth-feature">
                <Icon name="production" size="18"/>
                <Label text="Production planned against real stock"/>
            </HBox>
            <HBox styleClass="auth-feature">
                <Icon name="inventory" size="18"/>
                <Label text="Lots and expiry, earliest expiry used first"/>
            </HBox>
            <HBox styleClass="auth-feature">
                <Icon name="pointofsale" size="18"/>
                <Label text="Point of sale with receipts and voids"/>
            </HBox>
        </VBox>
        <Region VBox.vgrow="ALWAYS" minHeight="40"/>
        <Label fx:id="versionLabel" styleClass="auth-footer"/>
    </VBox>
    <StackPane styleClass="auth-form-area" HBox.hgrow="ALWAYS">
        <VBox styleClass="auth-form" maxWidth="380" maxHeight="-Infinity">
            <VBox spacing="4">
                <Label text="Reset Kata Sandi" styleClass="auth-title"/>
                <Label fx:id="bakeryLabel" styleClass="auth-subtitle"/>
            </VBox>

            <!-- LANGKAH 1: Verifikasi identitas -->
            <VBox fx:id="stepVerifyPane" spacing="12">
                <VBox styleClass="field-group">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="usernameField" promptText="Masukkan username Anda"
                               onAction="#onLookup"/>
                </VBox>

                <!-- Pertanyaan keamanan (hanya tampil setelah lookup berhasil) -->
                <VBox fx:id="securityQuestionPane" managed="false" visible="false" spacing="12">
                    <Label fx:id="questionLabel" styleClass="banner-info" maxWidth="Infinity" wrapText="true"/>
                    <VBox styleClass="field-group">
                        <Label text="Jawaban" styleClass="form-label"/>
                        <TextField fx:id="answerField" promptText="Jawaban Anda"
                                   onAction="#onVerify"/>
                    </VBox>
                    <Button fx:id="verifyButton" text="Verifikasi →" maxWidth="Infinity"
                            defaultButton="true" styleClass="primary" onAction="#onVerify"/>
                </VBox>

                <!-- Tombol Lanjutkan (tersembunyi setelah pertanyaan muncul) -->
                <Button fx:id="lookupButton" text="Lanjutkan →" maxWidth="Infinity"
                        defaultButton="true" styleClass="primary" onAction="#onLookup"/>
            </VBox>

            <!-- LANGKAH 2: Buat kata sandi baru -->
            <VBox fx:id="stepResetPane" managed="false" visible="false" spacing="12">
                <VBox spacing="2">
                    <Label text="Buat Kata Sandi Baru" styleClass="subsection-title"/>
                    <Label fx:id="resetSubtitle" styleClass="auth-subtitle" wrapText="true"/>
                </VBox>
                <VBox styleClass="field-group">
                    <Label text="Kata Sandi Baru" styleClass="form-label"/>
                    <PasswordField fx:id="newPasswordField" promptText="Minimal 8 karakter"
                                   onAction="#onReset"/>
                </VBox>
                <VBox styleClass="field-group">
                    <Label text="Ulangi Kata Sandi Baru" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPasswordField" onAction="#onReset"/>
                </VBox>
                <Button fx:id="resetButton" text="Simpan Kata Sandi Baru" maxWidth="Infinity"
                        defaultButton="true" styleClass="primary" onAction="#onReset"/>
            </VBox>

            <!-- Error / Info label (dipakai di kedua langkah) -->
            <Label fx:id="errorLabel" wrapText="true" maxWidth="Infinity"
                   managed="false" visible="false"/>

            <!-- Tombol kembali -->
            <Button text="← Kembali ke halaman masuk" maxWidth="Infinity"
                    styleClass="link-button" onAction="#onBack"/>
        </VBox>
    </StackPane>
</HBox>
