<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.SuppliersController" styleClass="view">
    <HBox styleClass="toolbar">
        <TextField fx:id="searchField" promptText="Search name, contact or phone..." prefWidth="260"/>
        <CheckBox fx:id="inactiveCheck" text="Show inactive"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ New supplier" styleClass="primary" onAction="#onNew"/>
        <Button text="Edit" onAction="#onEdit"/>
        <Button text="Activate / deactivate" onAction="#onToggle"/>
        <Button text="Receive goods" onAction="#onReceive"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <TableView fx:id="table"/>
        <VBox spacing="6">
            <Label fx:id="historyTitle" text="Deliveries of the selected supplier" styleClass="card-title"/>
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>
</VBox>
