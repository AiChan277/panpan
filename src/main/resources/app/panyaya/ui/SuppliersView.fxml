<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.SuppliersController" styleClass="view">
    <HBox styleClass="toolbar">
        <HBox styleClass="search-box" prefWidth="280" minWidth="150">
            <Icon name="search" size="15"/>
            <TextField fx:id="searchField" promptText="Search name, contact or phone" HBox.hgrow="ALWAYS"/>
        </HBox>
        <CheckBox fx:id="inactiveCheck" text="Show inactive" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button text="Receive goods" onAction="#onReceive">
            <graphic><Icon name="inventory" size="15"/></graphic>
        </Button>
        <Button text="Activate / deactivate" onAction="#onToggle">
            <graphic><Icon name="ban" size="15"/></graphic>
        </Button>
        <Button text="Edit" onAction="#onEdit">
            <graphic><Icon name="edit" size="15"/></graphic>
        </Button>
        <Button text="New supplier" styleClass="primary" onAction="#onNew" minWidth="-Infinity">
            <graphic><Icon name="plus" size="15"/></graphic>
        </Button>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" minHeight="160"/>
        <VBox spacing="8" minHeight="140">
            <HBox styleClass="section-header">
                <Icon name="supplier" size="16"/>
                <Label fx:id="historyTitle" text="Deliveries of the selected supplier" styleClass="card-title"/>
            </HBox>
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>
</VBox>
