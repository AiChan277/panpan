<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.panyaya.ui.MainController" styleClass="app-shell">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar">
            <HBox fx:id="brandBox" styleClass="brand-box">
                <ImageView fitWidth="30" fitHeight="30" preserveRatio="true" smooth="true">
                    <Image url="@img/icon-64.png"/>
                </ImageView>
                <VBox fx:id="brandText" styleClass="brand-text">
                    <Label text="パン屋ヤ" styleClass="sidebar-brand-jp"/>
                    <Label text="PAN-YA YA" styleClass="sidebar-brand"/>
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" styleClass="nav-scroll" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
                <VBox fx:id="navBox" styleClass="nav-box"/>
            </ScrollPane>
            <VBox fx:id="userBox" styleClass="user-box">
                <HBox styleClass="user-row">
                    <StackPane styleClass="avatar">
                        <Label fx:id="avatarLabel"/>
                    </StackPane>
                    <VBox fx:id="userText" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="userLabel" styleClass="sidebar-user"/>
                        <Label fx:id="roleLabel" styleClass="sidebar-role"/>
                    </VBox>
                </HBox>
                <FlowPane fx:id="userActions" styleClass="user-actions">
                    <Button fx:id="passwordButton" text="Password" onAction="#onChangePassword"
                            styleClass="sidebar-button">
                        <graphic><Icon name="key" size="15"/></graphic>
                        <tooltip><Tooltip text="Change password"/></tooltip>
                    </Button>
                    <Button fx:id="signOutButton" text="Sign out" onAction="#onSignOut" styleClass="sidebar-button">
                        <graphic><Icon name="logout" size="15"/></graphic>
                        <tooltip><Tooltip text="Sign out"/></tooltip>
                    </Button>
                </FlowPane>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox>
            <HBox styleClass="app-header">
                <Button fx:id="collapseButton" styleClass="icon-button" onAction="#onToggleSidebar">
                    <graphic><Icon name="sidebar" size="18"/></graphic>
                    <tooltip><Tooltip text="Collapse or expand the menu"/></tooltip>
                </Button>
                <VBox styleClass="page-heading" HBox.hgrow="ALWAYS" minWidth="0">
                    <HBox styleClass="breadcrumb">
                        <Label fx:id="bakeryLabel"/>
                        <Icon name="chevron-right" size="11"/>
                        <Label fx:id="crumbSection"/>
                    </HBox>
                    <Label fx:id="pageTitle" styleClass="page-title"/>
                    <Label fx:id="pageDescription" styleClass="page-description"/>
                </VBox>
                <HBox styleClass="header-actions">
                    <Label fx:id="headerDate" styleClass="header-context"/>
                    <Button fx:id="alertsButton" styleClass="icon-button" onAction="#onAlerts" managed="false" visible="false">
                        <graphic>
                            <StackPane>
                                <Icon name="bell" size="18"/>
                                <Label fx:id="alertCount" styleClass="alert-count" visible="false"
                                       StackPane.alignment="TOP_RIGHT" translateX="7" translateY="-6"/>
                            </StackPane>
                        </graphic>
                        <tooltip><Tooltip fx:id="alertsTooltip" text="Stock alerts"/></tooltip>
                    </Button>
                    <Button fx:id="refreshButton" styleClass="icon-button" onAction="#onRefresh">
                        <graphic><Icon name="refresh" size="18"/></graphic>
                        <tooltip><Tooltip text="Refresh this page"/></tooltip>
                    </Button>
                </HBox>
            </HBox>
            <StackPane fx:id="contentPane" styleClass="page-content" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="statusLabel" text="Ready"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="busyIndicator" visible="false" prefWidth="14" prefHeight="14" maxWidth="14" maxHeight="14"/>
            <Label fx:id="saveLabel">
                <graphic><Icon name="check-circle" size="13"/></graphic>
            </Label>
        </HBox>
    </bottom>
</BorderPane>
