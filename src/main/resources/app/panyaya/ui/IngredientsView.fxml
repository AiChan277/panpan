<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.IngredientsController" styleClass="view">
    <HBox styleClass="toolbar">
        <TextField fx:id="searchField" promptText="Search name or code..." prefWidth="240"/>
        <CheckBox fx:id="inactiveCheck" text="Show inactive"/>
        <Label fx:id="summaryLabel" styleClass="hint"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="newButton" text="+ New ingredient" styleClass="primary" onAction="#onNew"/>
        <Button fx:id="editButton" text="Edit" onAction="#onEdit"/>
        <Button fx:id="toggleButton" text="Activate / deactivate" onAction="#onToggle"/>
        <Button fx:id="receiveButton" text="Receive goods" onAction="#onReceive"/>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.62" VBox.vgrow="ALWAYS">
        <TableView fx:id="table"/>
        <VBox spacing="6">
            <Label fx:id="lotsTitle" text="Lots of the selected ingredient" styleClass="card-title"/>
            <TableView fx:id="lotsTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>
</VBox>
