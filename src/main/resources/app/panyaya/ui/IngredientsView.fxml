<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.IngredientsController" styleClass="view">
    <HBox styleClass="toolbar">
        <HBox styleClass="search-box" prefWidth="250" minWidth="150">
            <Icon name="search" size="15"/>
            <TextField fx:id="searchField" promptText="Search name or code" HBox.hgrow="ALWAYS"/>
        </HBox>
        <CheckBox fx:id="inactiveCheck" text="Show inactive" minWidth="-Infinity"/>
        <Label fx:id="summaryLabel" styleClass="hint" minWidth="0"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button fx:id="receiveButton" text="Receive goods" onAction="#onReceive">
            <graphic><Icon name="supplier" size="15"/></graphic>
        </Button>
        <Button fx:id="toggleButton" text="Activate / deactivate" onAction="#onToggle">
            <graphic><Icon name="ban" size="15"/></graphic>
        </Button>
        <Button fx:id="editButton" text="Edit" onAction="#onEdit">
            <graphic><Icon name="edit" size="15"/></graphic>
        </Button>
        <Button fx:id="newButton" text="New ingredient" styleClass="primary" onAction="#onNew" minWidth="-Infinity">
            <graphic><Icon name="plus" size="15"/></graphic>
        </Button>
    </HBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.6" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" minHeight="160"/>
        <VBox spacing="8" minHeight="140">
            <HBox styleClass="section-header">
                <Icon name="inventory" size="16"/>
                <Label fx:id="lotsTitle" text="Lots of the selected ingredient" styleClass="card-title"/>
            </HBox>
            <TableView fx:id="lotsTable" VBox.vgrow="ALWAYS"/>
        </VBox>
    </SplitPane>
</VBox>
