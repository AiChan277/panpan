<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.UsersController" styleClass="view">
    <HBox styleClass="toolbar">
        <HBox styleClass="section-header">
            <Icon name="usermanagement" size="16"/>
            <Label text="Accounts" styleClass="section-title"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button text="Activate / deactivate" onAction="#onToggle">
            <graphic><Icon name="ban" size="15"/></graphic>
        </Button>
        <Button text="Reset password" onAction="#onReset">
            <graphic><Icon name="key" size="15"/></graphic>
        </Button>
        <Button text="Edit" onAction="#onEdit">
            <graphic><Icon name="edit" size="15"/></graphic>
        </Button>
        <Button text="New user" styleClass="primary" onAction="#onNew" minWidth="-Infinity">
            <graphic><Icon name="plus" size="15"/></graphic>
        </Button>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <Label text="Roles - Owner: everything. Baker: production, recipes (draft), receiving, waste, reports. Cashier: point of sale, own sales, product waste."
           styleClass="banner-info" wrapText="true" maxWidth="Infinity">
        <graphic><Icon name="info" size="16"/></graphic>
    </Label>
</VBox>
