<?xml version="1.0" encoding="UTF-8"?>

<?import app.panyaya.ui.common.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.panyaya.ui.ProductsController" styleClass="view">
    <HBox styleClass="toolbar">
        <HBox styleClass="search-box" prefWidth="250" minWidth="150">
            <Icon name="search" size="15"/>
            <TextField fx:id="searchField" promptText="Search name or SKU" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ComboBox fx:id="categoryFilter" promptText="All categories" prefWidth="160" minWidth="110"/>
        <ComboBox fx:id="typeFilter" promptText="All types" prefWidth="150" minWidth="100"/>
        <CheckBox fx:id="archivedCheck" text="Show archived" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button text="Price history" onAction="#onPriceHistory">
            <graphic><Icon name="clock" size="15"/></graphic>
        </Button>
        <Button fx:id="archiveButton" text="Archive / restore" onAction="#onArchive">
            <graphic><Icon name="archive" size="15"/></graphic>
        </Button>
        <Button fx:id="editButton" text="Edit" onAction="#onEdit">
            <graphic><Icon name="edit" size="15"/></graphic>
        </Button>
        <Button fx:id="newButton" text="New product" styleClass="primary" onAction="#onNew" minWidth="-Infinity">
            <graphic><Icon name="plus" size="15"/></graphic>
        </Button>
    </HBox>
    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" HBox.hgrow="ALWAYS"/>
        <VBox styleClass="panel" prefWidth="250" minWidth="220">
            <HBox styleClass="panel-header">
                <Icon name="tag" size="16"/>
                <Label text="Categories" styleClass="card-title"/>
            </HBox>
            <ListView fx:id="categoryList" VBox.vgrow="ALWAYS"/>
            <FlowPane hgap="6" vgap="6">
                <Button fx:id="addCategoryButton" text="Add" onAction="#onAddCategory">
                    <graphic><Icon name="plus" size="14"/></graphic>
                </Button>
                <Button fx:id="renameCategoryButton" text="Rename" onAction="#onRenameCategory">
                    <graphic><Icon name="edit" size="14"/></graphic>
                </Button>
                <Button fx:id="toggleCategoryButton" text="On / off" onAction="#onToggleCategory">
                    <graphic><Icon name="ban" size="14"/></graphic>
                </Button>
            </FlowPane>
            <Label text="Inactive categories cannot be chosen for new products." styleClass="hint" wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
